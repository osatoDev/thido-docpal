// Prisma schema for Thido
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth.js required models ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App models ----------

model User {
  id                       String             @id @default(cuid())
  name                     String?
  email                    String?            @unique
  emailVerified            DateTime?
  image                    String?
  passwordHash             String?            @db.Text
  sessionVersion           Int                @default(0)
  betaSeat                 Int?               @unique
  betaGrantedAt            DateTime?
  stripeCustomerId         String?            @unique
  stripeSubscriptionId     String?            @unique
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
  stripeCancelAtPeriodEnd  Boolean            @default(false)
  aiCreditsUsed            Int                @default(0)
  aiCreditsPeriodStart     DateTime           @default(now())
  createdAt                DateTime           @default(now())
  activationNudgeSentAt    DateTime?
  accounts                 Account[]
  aiCreditCharges          AiCreditCharge[]
  sessions                 Session[]
  documents                Document[]
  /// The one continuous plan page this person sees after signing in.
  planDocumentId           String?            @unique
  planDocument             Document?          @relation("UserPlan", fields: [planDocumentId], references: [id], onDelete: SetNull)
  settings                 UserSettings?
  authTokens               AuthToken[]
  aiGenerations            AiGeneration[]
  feedbackThread           FeedbackThread?
  feedbackMessages         FeedbackMessage[]
  uploadedDocumentImages   DocumentImage[]    @relation("DocumentImageUploader")
  documentRevisions        DocumentRevision[] @relation("DocumentRevisionActor")
  planFeedback             PlanFeedback[]
  waitlistReviews          WaitlistEntry[]    @relation("WaitlistReviewer")
  waitlistAdmission        WaitlistEntry?     @relation("WaitlistApprovedUser")
}

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WaitlistSignupMethod {
  PASSWORD
  GOOGLE
}

model WaitlistEntry {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  passwordHash   String?              @db.Text
  signupMethod   WaitlistSignupMethod
  status         WaitlistStatus       @default(PENDING)
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                @relation("WaitlistReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedUserId String?              @unique
  approvedUser   User?                @relation("WaitlistApprovedUser", fields: [approvedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([reviewedById])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  createdAt   DateTime @default(now())
  processedAt DateTime
}

enum FeedbackCategory {
  PROBLEM
  IDEA
  QUESTION
  OTHER
}

enum FeedbackThreadStatus {
  OPEN
  CLOSED
}

enum FeedbackAuthorType {
  USER
  FOUNDER
}

model FeedbackThread {
  id                   String               @id @default(cuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             FeedbackCategory     @default(OTHER)
  status               FeedbackThreadStatus @default(OPEN)
  currentPath          String?
  responseDueAt        DateTime?
  firstRespondedAt     DateTime?
  founderNotifiedAt    DateTime?
  lastUserMessageAt    DateTime?
  lastFounderMessageAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  messages             FeedbackMessage[]

  @@index([status, responseDueAt])
  @@index([updatedAt])
}

model FeedbackMessage {
  id         String             @id @default(cuid())
  threadId   String
  thread     FeedbackThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorType FeedbackAuthorType
  body       String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([threadId, createdAt])
  @@index([authorId])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@unique([userId, type])
  @@index([expiresAt])
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiModel                String   @default("claude-sonnet-5")
  checklistMoveControls  Boolean  @default(true)
  planFeedbackDailyLimit Int      @default(3)
  /// Morning email with today's tasks and what was checked off yesterday.
  dailyPlanEmail         Boolean  @default(false)
  /// IANA time zone from the browser, so "today" is the person's own day.
  timeZone               String?
  /// Local day (YYYY-MM-DD) the daily email last went out, so it sends once.
  dailyPlanEmailSentDay  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum DocumentStatus {
  DRAFTING
  GENERATING
  READY
}

enum DocumentRevisionSource {
  INITIAL
  USER
  AI
  RESTORE
  IMPORT
}

model Document {
  id               String             @id @default(cuid())
  title            String             @default("Untitled Document")
  titleManuallySet Boolean            @default(false)
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  planOwner        User?              @relation("UserPlan")
  status           DocumentStatus     @default(DRAFTING)
  isPlaceholder    Boolean            @default(false)
  content          Json?
  revision         Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastAccessedAt   DateTime           @default(now())
  aiGenerations    AiGeneration[]
  aiCreditCharges  AiCreditCharge[]
  images           DocumentImage[]
  revisions        DocumentRevision[]
  planFeedback     PlanFeedback[]

  @@index([ownerId])
  @@index([isPlaceholder, updatedAt])
}

model DocumentRevision {
  id                   String                 @id @default(cuid())
  documentId           String
  document             Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision             Int
  title                String
  content              Json?
  source               DocumentRevisionSource
  actorId              String?
  actor                User?                  @relation("DocumentRevisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  restoredFromRevision Int?
  createdAt            DateTime               @default(now())

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
  @@index([actorId])
}

model DocumentImage {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation("DocumentImageUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  blobUrl      String   @db.Text
  pathname     String   @unique
  contentType  String
  size         Int
  alt          String   @default("")
  createdAt    DateTime @default(now())

  @@index([documentId])
  @@index([uploadedById])
}

enum AiFeature {
  DOCUMENT_FOLLOWUPS
  DOCUMENT_GENERATE
  COMMENT_RESPOND
  TASK_SCHEDULE
  PLAN_FEEDBACK
  PLAN_REQUEST
}

enum PlanFeedbackTrigger {
  MANUAL
  AUTO
}

/// AI feedback on one day's plan. `localDate` is the user's calendar day when
/// it was given, so automatic feedback can be capped per day in their timezone.
model PlanFeedback {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  day        String
  localDate  String
  trigger    PlanFeedbackTrigger
  feedback   String
  createdAt  DateTime            @default(now())

  @@index([userId, localDate, trigger])
  @@index([documentId, day])
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model AiGeneration {
  id       String             @id @default(cuid())
  feature  AiFeature
  status   AiGenerationStatus @default(PENDING)
  provider String             @default("anthropic")
  model    String

  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  providerRequestId String?
  environment       String?
  stopReason        String?
  serviceTier       String?
  inferenceGeo      String?

  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  latencyMs    Int?
  firstTokenMs Int?

  inputTokens           Int?
  outputTokens          Int?
  reasoningTokens       Int?
  cacheCreationTokens   Int?
  cacheCreation5mTokens Int?
  cacheCreation1hTokens Int?
  cacheReadTokens       Int?

  estimatedCostMicroUsd BigInt?
  priceVersion          String?

  errorCode    String?
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([feature, startedAt])
  @@index([status, startedAt])
  @@index([userId, startedAt])
  @@index([documentId])
  @@index([providerRequestId])
}

/// One row per AI credit consumption, written transactionally with the running
/// `User.aiCreditsUsed` counter. Append-only history so a user can audit what
/// their monthly allowance was spent on; `refundedAt` is stamped when a failed
/// action returns the credits. `credits` and `plan` are denormalised so the
/// record stays accurate after weights or plan limits change.
model AiCreditCharge {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         AiFeature
  model          String
  credits        Int
  plan           String
  periodStart    DateTime
  balanceAfter   Int
  documentId     String?
  document       Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  aiGenerationId String?   @unique
  refundedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, periodStart])
  @@index([documentId])
}
