// Prisma schema for Thido
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth.js required models ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App models ----------

model User {
  id                       String                 @id @default(cuid())
  name                     String?
  email                    String?                @unique
  emailVerified            DateTime?
  image                    String?
  passwordHash             String?                @db.Text
  sessionVersion           Int                    @default(0)
  betaSeat                 Int?                   @unique
  betaGrantedAt            DateTime?
  stripeCustomerId         String?                @unique
  stripeSubscriptionId     String?                @unique
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
  stripeCancelAtPeriodEnd  Boolean                @default(false)
  aiCreditsUsed            Int                    @default(0)
  aiCreditsPeriodStart     DateTime               @default(now())
  createdAt                DateTime               @default(now())
  accounts                 Account[]
  sessions                 Session[]
  documents                Document[]
  spreadsheets             Spreadsheet[]
  comments                 Comment[]
  settings                 UserSettings?
  authTokens               AuthToken[]
  aiGenerations            AiGeneration[]
  feedbackThread           FeedbackThread?
  feedbackMessages         FeedbackMessage[]
  collaboratorInvites      DocumentCollaborator[] @relation("CollaboratorInviter")
  uploadedDocumentImages   DocumentImage[]        @relation("DocumentImageUploader")
  documentRevisions        DocumentRevision[]     @relation("DocumentRevisionActor")
  documentLinkAccesses     DocumentLinkAccess[]
  documentFolders          DocumentFolder[]
  waitlistReviews          WaitlistEntry[]        @relation("WaitlistReviewer")
  waitlistAdmission        WaitlistEntry?         @relation("WaitlistApprovedUser")
}

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WaitlistSignupMethod {
  PASSWORD
  GOOGLE
}

model WaitlistEntry {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  passwordHash   String?              @db.Text
  signupMethod   WaitlistSignupMethod
  status         WaitlistStatus       @default(PENDING)
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                @relation("WaitlistReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedUserId String?              @unique
  approvedUser   User?                @relation("WaitlistApprovedUser", fields: [approvedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([reviewedById])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  createdAt   DateTime @default(now())
  processedAt DateTime
}

enum FeedbackCategory {
  PROBLEM
  IDEA
  QUESTION
  OTHER
}

enum FeedbackThreadStatus {
  OPEN
  CLOSED
}

enum FeedbackAuthorType {
  USER
  FOUNDER
}

model FeedbackThread {
  id                   String               @id @default(cuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             FeedbackCategory     @default(OTHER)
  status               FeedbackThreadStatus @default(OPEN)
  currentPath          String?
  responseDueAt        DateTime?
  firstRespondedAt     DateTime?
  founderNotifiedAt    DateTime?
  lastUserMessageAt    DateTime?
  lastFounderMessageAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  messages             FeedbackMessage[]

  @@index([status, responseDueAt])
  @@index([updatedAt])
}

model FeedbackMessage {
  id         String             @id @default(cuid())
  threadId   String
  thread     FeedbackThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorType FeedbackAuthorType
  body       String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([threadId, createdAt])
  @@index([authorId])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@unique([userId, type])
  @@index([expiresAt])
}

enum AICommentMode {
  PROPOSE
  AUTO
  AUTO_APPLY
}

enum DocumentStartMode {
  NEW_DOCUMENT
  MOST_RECENT
}

model UserSettings {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiCommentMode          AICommentMode     @default(AUTO)
  aiModel                String            @default("claude-sonnet-5")
  documentStartMode      DocumentStartMode @default(NEW_DOCUMENT)
  applicationStyle       String            @default("classic")
  checklistMoveControls  Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

enum DocumentStatus {
  DRAFTING
  GENERATING
  READY
}

enum DocumentRevisionSource {
  INITIAL
  USER
  AI
  RESTORE
  IMPORT
}

enum DocumentPermission {
  VIEW
  COMMENT
  EDIT
  FULL
}

model Document {
  id               String                 @id @default(cuid())
  guestDraftId     String?                @unique
  shareToken       String?                @unique
  sharePermission  DocumentPermission     @default(VIEW)
  title            String                 @default("Untitled Document")
  titleManuallySet Boolean                @default(false)
  ownerId          String
  owner            User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId         String?
  folder           DocumentFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  status           DocumentStatus         @default(DRAFTING)
  isPlaceholder    Boolean                @default(false)
  content          Json?
  revision         Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  lastAccessedAt   DateTime               @default(now())
  promptAnswers    PromptAnswer[]
  comments         Comment[]
  collaborators    DocumentCollaborator[]
  aiGenerations    AiGeneration[]
  images           DocumentImage[]
  revisions        DocumentRevision[]
  linkAccesses     DocumentLinkAccess[]

  @@index([ownerId])
  @@index([folderId])
  @@index([isPlaceholder, updatedAt])
}

model DocumentFolder {
  id           String        @id @default(cuid())
  name         String
  nameKey      String
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents    Document[]
  spreadsheets Spreadsheet[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([ownerId, nameKey])
  @@index([ownerId, name])
}

model Spreadsheet {
  id             String          @id @default(cuid())
  title          String          @default("Untitled Spreadsheet")
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId       String?
  folder         DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  content        Json
  revision       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastAccessedAt DateTime        @default(now())

  @@index([ownerId])
  @@index([folderId])
}

model DocumentLinkAccess {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([userId])
  @@index([documentId, lastAccessedAt])
}

model DocumentRevision {
  id                   String                 @id @default(cuid())
  documentId           String
  document             Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision             Int
  title                String
  content              Json?
  source               DocumentRevisionSource
  actorId              String?
  actor                User?                  @relation("DocumentRevisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  restoredFromRevision Int?
  createdAt            DateTime               @default(now())

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
  @@index([actorId])
}

model DocumentImage {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation("DocumentImageUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  blobUrl      String   @db.Text
  pathname     String   @unique
  contentType  String
  size         Int
  alt          String   @default("")
  createdAt    DateTime @default(now())

  @@index([documentId])
  @@index([uploadedById])
}

model DocumentCollaborator {
  id          String             @id @default(cuid())
  documentId  String
  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  email       String
  permission  DocumentPermission @default(VIEW)
  invitedById String?
  invitedBy   User?              @relation("CollaboratorInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([documentId, email])
  @@index([email])
  @@index([invitedById])
}

enum PromptStage {
  INITIAL
  FOLLOWUP
}

model PromptAnswer {
  id         String      @id @default(cuid())
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stage      PromptStage
  order      Int
  question   String      @db.Text
  answer     String      @default("") @db.Text
  createdAt  DateTime    @default(now())

  @@index([documentId])
}

enum AuthorType {
  USER
  AI
}

enum CommentIntent {
  QUESTION
  CHANGE_REQUEST
  FEEDBACK
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum CommentScope {
  SELECTION
  DOCUMENT
}

enum CommentAiStatus {
  NOT_REQUESTED
  PENDING
  SUCCEEDED
  FAILED
}

model Comment {
  id         String     @id @default(cuid())
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  authorType AuthorType @default(USER)

  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  scope CommentScope @default(SELECTION)

  // Selection comments match the Tiptap CommentMark's commentId attribute.
  // Document comments deliberately have no text anchor.
  anchorMarkId String?
  quotedText   String? @db.Text
  isOrphaned   Boolean @default(false)

  intent CommentIntent?
  status CommentStatus  @default(OPEN)
  body   String         @db.Text

  aiStatus      CommentAiStatus @default(NOT_REQUESTED)
  aiStartedAt   DateTime?
  aiCompletedAt DateTime?

  suggestion    Suggestion?
  aiGenerations AiGeneration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([documentId, scope, aiStatus])
  @@index([anchorMarkId])
  @@index([parentId])
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_APPLIED
}

model Suggestion {
  id         String  @id @default(cuid())
  commentId  String  @unique
  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  documentId String

  scope        CommentScope     @default(SELECTION)
  anchorMarkId String?
  originalText String           @db.Text
  proposedText String           @db.Text
  status       SuggestionStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([documentId])
}

enum AiFeature {
  DOCUMENT_FOLLOWUPS
  DOCUMENT_GENERATE
  COMMENT_RESPOND
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model AiGeneration {
  id       String             @id @default(cuid())
  feature  AiFeature
  status   AiGenerationStatus @default(PENDING)
  provider String             @default("anthropic")
  model    String

  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  commentId  String?
  comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)

  providerRequestId String?
  environment       String?
  stopReason        String?
  serviceTier       String?
  inferenceGeo      String?

  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  latencyMs    Int?
  firstTokenMs Int?

  inputTokens           Int?
  outputTokens          Int?
  reasoningTokens       Int?
  cacheCreationTokens   Int?
  cacheCreation5mTokens Int?
  cacheCreation1hTokens Int?
  cacheReadTokens       Int?

  estimatedCostMicroUsd BigInt?
  priceVersion          String?

  errorCode    String?
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([feature, startedAt])
  @@index([status, startedAt])
  @@index([userId, startedAt])
  @@index([documentId])
  @@index([commentId])
  @@index([providerRequestId])
}
