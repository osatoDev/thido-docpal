# Copy to .env and fill in real values for local development.
# In production on Vercel, set these as project environment variables instead.

# Postgres (Neon on Vercel: DATABASE_URL = pooled connection string,
# DATABASE_URL_UNPOOLED = direct connection string, used only for migrations)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional authentication email (Resend). Verify your sending domain in
# Resend before replacing the testing sender.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Thido <onboarding@resend.dev>"

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Rollbar — installed through the Vercel Marketplace. The integration creates
# installation-specific variables; keep these names aligned with the connected
# Rollbar resource and never expose the server token to browser code.
NEXT_PUBLIC_ROLLBAR_THIDO_DOCPAL_CLIENT_TOKEN_1785444690=""
ROLLBAR_THIDO_DOCPAL_SERVER_TOKEN_1785444690=""

# Admin console — comma-separated account emails allowed to access /admin.
ADMIN_EMAILS=""

# Server-only credentials used to show aggregated Vercel Web Analytics in
# /admin. VERCEL_TEAM_ID is only needed when the project belongs to a team.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Test login (dev/CI only) — adds a "Continue without Google" option on
# /login that signs in as any email with no OAuth. Forced off in production
# regardless of this value. Never set this in a real deployment.
ENABLE_TEST_LOGIN="true"
